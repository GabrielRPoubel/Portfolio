{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/dist/index.html" },
    { "source": "/(.*)", "destination": "/dist/index.html" }
  ],
  "headers": [
    {
      "source": "/fotos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/favicon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
